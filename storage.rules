rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'hiddenpantry50@gmail.com' || 
         request.auth.uid == 'K35k8MPFWSbmKo3CTe8Wz8waZAS2');
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Certificates folder
    match /certificates/{nutritionistId}/{fileName} {
      // Allow public read so the admin can open the unguessable token URL in their browser
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == nutritionistId;
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == nutritionistId);
    }

    // =========================
    // Review Photos (any user, authenticated)
    // =========================
    match /review_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // Recipe Photos (any user, authenticated)
    // =========================
    match /recipe_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // Profile Pictures (user-specific)
    // =========================
    match /profile_pictures/{uid} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid;
    }
    
    // TEMPORARY: Allow all writes for testing other paths if authenticated
    match /{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
