rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'hiddenpantry.support@gmail.com' || 
         request.auth.uid == 'K35k8MPFWSbmKo3CTe8Wz8waZAS2');
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    
    // ==================== NUTRITIONIST VERIFICATION RULES ====================
    match /nutritionists/{nutritionistId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(nutritionistId);

      // Nutritionist owner can update profile fields.
      // Any authenticated user can increment rating tallies.
      allow update: if isAdmin() || (
        isOwner(nutritionistId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phoneNumber', 'bio', 'organizationName', 'domain', 'photoUrl', 
          'updatedAt', 'lastLoginAt', 'hasLoggedInAfterRejection', 'fcmToken',
          'licenseNumber', 'expiryDate', 'certificateUrl', 'notificationsEnabled', 'bankDetails', 'payoutMethod',
          'totalEarnings', 'pendingPayout',
          'total_review_count', 'total_rating_sum'
        ])
      ) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'total_review_count', 'total_rating_sum'
        ])
      );
      allow delete: if isAdmin() || isOwner(nutritionistId);

      // Reviews subcollection - one review doc per user (doc ID = uid)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && (reviewId == request.auth.uid || isAdmin());
      }

      match /notifications/{notiId} {
        allow read, delete: if isOwner(nutritionistId) || isAdmin();
        allow create: if isAuthenticated();
        allow update: if isOwner(nutritionistId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      match /subscription_plans/{planId} {
        allow read: if true;
        allow write: if isOwner(nutritionistId) || isAdmin();
      }

      match /tips/{tipId} {
        allow read: if true;
        allow create, delete: if isOwner(nutritionistId) || isAdmin();
        allow update: if isOwner(nutritionistId) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount', 'likedBy'])
        );
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
        }
      }

      match /earnings_history/{historyId} {
        allow read: if request.auth != null && (request.auth.uid == nutritionistId || isAdmin());
        allow write: if isAdmin();
      }

      match /meal_plans/{mealPlanId} {
        allow read: if true;
        allow write: if isOwner(nutritionistId) || isAdmin();
      }
    }

    // ==================== PAYOUT RULES ====================
    match /payouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.nutritionistId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    // ==================== USER RULES ====================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && (
        request.auth.uid == userId || 
        (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'fullName', 'suspendedUntil'])) ||
        (resource == null && request.resource.data.keys().hasOnly(['followerCount', 'fullName']))
      ));

      match /payment_methods/{cardId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /cookbooks/{cookbookId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /likes/{recipeId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /following/{authorId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if isAdmin() || (request.auth != null && request.auth.uid == followerId);
      }
      match /saved_meal_plans/{planId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /views/{viewId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      match /notifications/{notiId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated();
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ==================== RECIPE & METRICS RULES ====================
    match /recipe_metrics/{recipeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }
    match /trending_events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // ==================== REVIEW RULES ====================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() || isAdmin(); 
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      match /replies/{replyId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ==================== SUBSCRIPTION RULES ====================
    match /subscriptions/{subId} {
      allow read: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || 
                     resource.data.nutritionistId == request.auth.uid || 
                     isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /pending_purchases/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // ==================== PLATFORM PAYMENT RULES ====================
    match /platform_payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.nutritionistId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ==================== WITHDRAWAL & PAYOUT HISTORY RULES ====================
    match /withdrawal_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.nutritionistId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.nutritionistId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /payout_history/{historyId} {
      allow read: if request.auth != null && (resource.data.nutritionistId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ==================== CHAT RULES ====================
    match /chats/{chatId} {
      function isParticipant() {
        let isExisting = resource != null && 'participants' in resource.data && request.auth.uid in resource.data.participants;
        let isNew = request.resource != null && 'participants' in request.resource.data && request.auth.uid in request.resource.data.participants;
        return (isAuthenticated() && (isExisting || isNew)) || isAdmin();
      }

      allow read, write, delete: if isParticipant();
      allow create: if isAuthenticated();

      match /messages/{messageId} {
        allow read, create, delete, update: if isAuthenticated() && (
          isAdmin() || (
            exists(/databases/$(database)/documents/chats/$(chatId)) &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
        );
      }
    }
    // ==================== MODERATION RULES ====================
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
