rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'hiddenpantry50@gmail.com' || 
         request.auth.uid == 'K35k8MPFWSbmKo3CTe8Wz8waZAS2');
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    
    // ==================== NUTRITIONIST VERIFICATION RULES ====================
    match /nutritionists/{nutritionistId} {
      // Allow read if:
      // - Authenticated (users can browse nutritionists)
      allow read: if true;
      
      // Allow create if authenticated (for signup)
      allow create: if isAuthenticated() && isOwner(nutritionistId);
      
      // Allow update if:
      // - Admin (can update everything)
      // - Owner (can update profile, bank details, settings but NOT financial/verification status)
      allow update: if isAdmin() || (
        isOwner(nutritionistId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phoneNumber', 'bio', 'organizationName', 'domain', 'photoUrl', 
          'updatedAt', 'lastLoginAt', 'hasLoggedInAfterRejection', 'fcmToken',
          'licenseNumber', 'expiryDate', 'certificateUrl', 'notificationsEnabled', 'bankDetails'
        ])
      );
      
      // Allow delete if:
      // - Admin
      // - Owner (for self-deletion)
      allow delete: if isAdmin() || isOwner(nutritionistId);

      // Notifications subcollection
      match /notifications/{notiId} {
        // Owner can read and delete
        allow read, delete: if isOwner(nutritionistId);
        // Any authenticated user can create
        allow create: if isAuthenticated();
        // Owner can update only 'read' status
        allow update: if isOwner(nutritionistId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // Subscription Plans subcollection
      match /subscription_plans/{planId} {
        allow read: if true;
        allow write: if isOwner(nutritionistId) || isAdmin();
      }

      // Tips subcollection
      match /tips/{tipId} {
        allow read: if true;
        allow create, delete: if isOwner(nutritionistId) || isAdmin();
        // Allow any authenticated user to update likes/commentCount
        allow update: if isOwner(nutritionistId) || isAdmin() || (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount', 'likedBy'])
        );

        // Comments on tips
        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }

      // Earnings History subcollection
      match /earnings_history/{historyId} {
        allow read: if request.auth != null && (request.auth.uid == nutritionistId || isAdmin());
        allow write: if isAdmin();
      }

      // Meal Plans subcollection
      match /meal_plans/{mealPlanId} {
        allow read: if true;
        allow write: if isOwner(nutritionistId) || isAdmin();
      }
    }

    // ==================== PAYOUT RULES ====================
    match /payouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.nutritionistId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    // ==================== USER RULES ====================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        // Allow updating follower count (Update existing)
        (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'fullName'])) ||
        // Allow creating doc with follower count (Create new shadow doc)
        (resource == null && request.resource.data.keys().hasOnly(['followerCount', 'fullName']))
      );

      // Payment methods subcollection
      match /payment_methods/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cookbooks subcollection
      match /cookbooks/{cookbookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Likes subcollection
      match /likes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Following subcollection
      match /following/{authorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Followers subcollection (New)
      match /followers/{followerId} {
        allow read: if request.auth != null; // Allow reading to show followers list
        // Allow write if the user is adding THEMSELVES as a follower
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
      
      // Saved Meal Plans subcollection
      match /saved_meal_plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Notifications subcollection
      match /notifications/{notiId} {
        // Owner can read and delete
        allow read, delete: if isOwner(userId);
        // Any authenticated user can create (for likes, follows, comments, messages)
        allow create: if isAuthenticated();
        // Owner can update only 'read' status
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ==================== RECIPE & METRICS RULES ====================
    
    // Popularity Tracking
    match /recipe_metrics/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Recipe Uploads
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ==================== REVIEW RULES ====================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; 
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Review replies subcollection
      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }

    // ==================== SUBSCRIPTION RULES ====================
    match /subscriptions/{subId} {
      allow read: if request.auth != null && 
                    (resource.data.userId == request.auth.uid || 
                     resource.data.nutritionistId == request.auth.uid || 
                     isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== PLATFORM PAYMENT RULES ====================
    match /platform_payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.nutritionistId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ==================== CHAT RULES ====================
    match /chats/{chatId} {
      // Helper to check if user is a participant of this chat
      function isParticipant() {
        return request.auth != null && (
          request.auth.uid in resource.data.participants ||
          request.auth.uid in request.resource.data.participants
        );
      }

      allow read, write, delete: if isParticipant();
      allow create: if request.auth != null;

      // Messages subcollection
      match /messages/{messageId} {
        // Only allow participants of the parent chat to interact with messages
        allow read, create, delete: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}